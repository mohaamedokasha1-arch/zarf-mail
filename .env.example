# =============================================================
#  متغيرات البيئة — ظرف (Zarf Mail)
#  انسخ هذا الملف إلى  .env  ثم عدّل القيم حسب حاجتك.
#  كل القيم اختيارية: المشروع يعمل فوراً بدون أي تعديل.
# =============================================================

# ---------- عام ----------
# NODE_ENV=production
# PORT=3000                          # منصة مثل Render/Railway تضبطه تلقائياً
# HOST=0.0.0.0
# PUBLIC_URL=http://localhost:3000
# APP_SECRET=غيّرني-إلى-قيمة-عشوائية-طويلة

# ---------- مزوّد البريد ----------
# mailtm : خدمة mail.tm (دومينات حقيقية — الأساسي والموصى به للنشر)
# local  : استقبال محلي (SMTP/Webhook) بدون دومين خارجي — للتجربة
# hybrid : الاثنان معاً
MAIL_PROVIDER=mailtm

# ---------- دومينات المزوّد المحلي (تُستخدم فقط في local/hybrid) ----------
# MAIL_DOMAINS=zarf.mail
# DEFAULT_DOMAIN=zarf.mail

# ---------- مدة الحياة (بالدقائق) ----------
# MAILBOX_TTL_MINUTES=10080          # 7 أيام
# MESSAGE_TTL_MINUTES=10080
# CLEANUP_INTERVAL_MINUTES=60

# ---------- استقبال البريد ----------
# SMTP_ENABLED=true                  # يفعل فقط مع local/hybrid
# SMTP_PORT=2525
# INBOUND_WEBHOOK_ENABLED=true
# INBOUND_WEBHOOK_KEY=غيّرني-إلى-مفتاح-سري-قوي

# ---------- الوضع التجريبي (زر "رسالة تجريبية" في الواجهة) ----------
# DEMO_MODE=false

# ---------- الحماية ----------
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_MS=60000
